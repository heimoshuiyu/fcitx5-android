<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="database"
            path="transcription_db" />
        <exclude
            domain="database"
            path="transcription_db-shm" />
        <exclude
            domain="database"
            path="transcription_db-wal" />
        <exclude
            domain="database"
            path="transcription_db-journal" />
        <exclude
            domain="sharedpref"
            path="voice_credentials.xml" />
        <exclude
            domain="device_sharedpref"
            path="voice_credentials.xml" />
        <exclude
            domain="file"
            path="usr" />
        <exclude
            domain="file"
            path="descriptor.json" />
        <exclude
            domain="file"
            path="licenses.json" />
        <exclude
            domain="file"
            path="README.md" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="database"
            path="transcription_db" />
        <exclude
            domain="database"
            path="transcription_db-shm" />
        <exclude
            domain="database"
            path="transcription_db-wal" />
        <exclude
            domain="database"
            path="transcription_db-journal" />
        <exclude
            domain="sharedpref"
            path="voice_credentials.xml" />
        <exclude
            domain="device_sharedpref"
            path="voice_credentials.xml" />
        <exclude
            domain="file"
            path="usr" />
        <exclude
            domain="file"
            path="descriptor.json" />
        <exclude
            domain="file"
            path="licenses.json" />
        <exclude
            domain="file"
            path="README.md" />
    </device-transfer>
</data-extraction-rules>
