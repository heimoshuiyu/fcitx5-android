<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
    Allow cleartext (HTTP) traffic for the OpenCode voice transcription API.
    The server typically runs on a local network address (e.g. 192.168.x.x).
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
